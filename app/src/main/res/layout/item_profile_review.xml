<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="#E0E0E0"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvUserInitials"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_user_badge"
            android:gravity="center"
            android:text="TB"
            android:textColor="@color/secondary_theme"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@+id/tvUserInitials"
            app:layout_constraintEnd_toStartOf="@+id/llStars"
            app:layout_constraintStart_toEndOf="@+id/tvUserInitials"
            app:layout_constraintTop_toTopOf="@+id/tvUserInitials">

            <TextView
                android:id="@+id/tvUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tomas B."
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTransactionInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bought a bookshelf • 2 wks ago"
                android:textColor="@color/text_light"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llStars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvUserInitials"
            app:layout_constraintBottom_toBottomOf="@+id/tvUserInitials">

            <ImageView android:id="@+id/star1" android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_star_filled" />
            <ImageView android:id="@+id/star2" android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_star_filled" />
            <ImageView android:id="@+id/star3" android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_star_filled" />
            <ImageView android:id="@+id/star4" android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_star_filled" />
            <ImageView android:id="@+id/star5" android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_star_filled" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvReviewContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Straightforward and friendly, held the item for a day while I found a van."
            android:textColor="@color/text_dark"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvUserInitials" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
